#include "resource.h"
#include <winres.h>

#pragma code_page(65001)

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDR_COLOR_PAGE UIFILE "ColorPage.xml"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

STRINGTABLE
BEGIN
	IDS_COLOR_LABEL "Current color: "
	IDS_CUSTOM_COLOR "Customized"
	IDS_ENABLE_TRANSPARENCY "E&nable transparency"
	IDS_TRANSPARENCY_DESCRIPTION "This option controls the transparent effect of windows, menus, the Start menu, and the taskbar."
	IDS_COLOR_SELECTOR_DESCRIPTION "Color selector"
	IDS_ACTION_CLICK "click"
	IDS_ACTION_PRESS "press"
END

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

STRINGTABLE
BEGIN
	IDS_COLOR_LABEL "当前颜色: "
	IDS_CUSTOM_COLOR "自定义"
	IDS_ENABLE_TRANSPARENCY "启用透明效果(&N)"
	IDS_TRANSPARENCY_DESCRIPTION "此选项可控制窗口、菜单、「开始」菜单和任务栏的透明效果。"
	IDS_COLOR_SELECTOR_DESCRIPTION "颜色选择器"
	IDS_ACTION_CLICK "单击"
	IDS_ACTION_PRESS "按"
END

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_TRADITIONAL

STRINGTABLE
BEGIN
	IDS_COLOR_LABEL "目前色彩: "
	IDS_CUSTOM_COLOR "自訂"
	IDS_ENABLE_TRANSPARENCY "啟用透明效果(&N)"
	IDS_TRANSPARENCY_DESCRIPTION "此選項控制視窗、功能表、[開始] 功能表及工作列的透明效果。"
	IDS_COLOR_SELECTOR_DESCRIPTION "色彩選擇器"
	IDS_ACTION_CLICK "按一下"
	IDS_ACTION_PRESS "按"
END
