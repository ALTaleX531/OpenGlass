    {
      "name": "Symbol_CAtlasedRectsVisual_CloneVisualTree_Pre19041",
      "id": "CAtlasedRectsVisual::CloneVisualTree_Pre19041",
      "bindings": [
        {
          "platform": null,
          "type": "HRESULT (*)(CAtlasedRectsVisual*, CVisual**, bool, bool, bool)",
          "ranges": [
            {
              "symbol_names": [
