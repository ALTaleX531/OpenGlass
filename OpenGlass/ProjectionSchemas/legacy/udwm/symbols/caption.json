              ],
              "min_inclusive": null,
              "max_exclusive": {
                "build": 19041
              }
            }
          ]
        }
      ],
      "requirement": "required",
      "kind": "raw",
      "notes": "17763.719/18362.267 CButton vtables inherit this entry. It allocates a plain CAtlasedRectsVisual and copies atlas images as CAtlasedImage, discarding the CAtlasButton glyph/glow payload. CButton clones must retain the derived visual and recreate native bitmap states; this entry identifies only that inherited vtable slot."
    },
    {
      "name": "Symbol_CVisual_CloneVisualTree_Pre19041",
      "id": "CVisual::CloneVisualTree_Pre19041",
      "bindings": [
        {
          "platform": null,
