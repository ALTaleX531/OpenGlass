<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="..\Common\NuGet.props" Condition="Exists('..\Common\NuGet.props')" />
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="ReleaseSigned|x64">
      <Configuration>ReleaseSigned</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{E7E2C6A4-36B2-4A61-9E2B-6B3D2B8B8C4F}</ProjectGuid>
    <RootNamespace>OpenGlassRenderTest</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Label="CppProject.SharedInputs">
    <CppProjectDefines>_WINDOWS;</CppProjectDefines>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <Import Project="..\Common\CppProject.Configuration.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="..\Common\CppProject.props" />
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..\OpenGlass;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <_ExternalClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </_ExternalClCompile>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(IntDir)Shaders;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
  </ItemDefinitionGroup>
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <ItemGroup>
    <ClInclude Include="Benchmark.hpp" />
    <ClInclude Include="Renderer.hpp" />
    <ClInclude Include="pch.h" />
    <None Include="README.md" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="Benchmark.cpp" />
    <ClCompile Include="Renderer.cpp" />
    <ClCompile Include="OpenGlassRenderTest.cpp" />
    <ClCompile Include="pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <_ExternalClCompile Include="..\Common\CustomBlurEffect.cpp" />
    <_ExternalClCompile Include="..\OpenGlass\AeroColorizationEffect.cpp" />
    <_ExternalClCompile Include="..\OpenGlass\AeroEffect.cpp" />
    <_ExternalClCompile Include="..\OpenGlass\BlurEffect.cpp" />
    <_ExternalClCompile Include="..\OpenGlass\BackdropCopy.cpp" />
    <_ExternalClCompile Include="..\OpenGlass\GlassEffectBatch.cpp" />
    <_ExternalClCompile Include="..\OpenGlass\GlassRealizer.cpp" />
    <_ExternalClCompile Include="..\OpenGlass\D3DGlassRealizer.cpp" />
    <_ExternalClCompile Include="..\OpenGlass\GlassRenderTarget.cpp" />
    <ResourceCompile Include="Shaders.rc" />
  </ItemGroup>
  <ItemGroup>
    <_RendererShader Include="$(MSBuildThisFileDirectory)..\OpenGlass\AeroColorizationEffect.hlsl">
      <Stage>Pixel</Stage><Entry>AeroColorizationEffect</Entry>
      <Defines>D2D_FULL_SHADER;D2D_ENTRY=AeroColorizationEffect;MINP_PREFIX=min16</Defines>
    </_RendererShader>
    <_RendererShader Include="$(MSBuildThisFileDirectory)..\OpenGlass\Blur.PS_BlurH.hlsl"><Stage>Pixel</Stage><Entry>main</Entry><Defines>MINP_PREFIX=min16</Defines></_RendererShader>
    <_RendererShader Include="$(MSBuildThisFileDirectory)..\OpenGlass\Blur.PS_BlurV.hlsl"><Stage>Pixel</Stage><Entry>main</Entry><Defines>MINP_PREFIX=min16</Defines></_RendererShader>
    <_RendererShader Include="$(MSBuildThisFileDirectory)..\OpenGlass\Blur.PS_BlurV_Vista.hlsl"><Stage>Pixel</Stage><Entry>main</Entry><Defines>MINP_PREFIX=min16</Defines></_RendererShader>
    <_RendererShader Include="$(MSBuildThisFileDirectory)..\OpenGlass\Blur.VS.hlsl"><Stage>Vertex</Stage><Entry>main</Entry><Defines>MINP_PREFIX=min16</Defines></_RendererShader>
  </ItemGroup>
  <!-- FXC's custom-effect export shares tracking keys with shader compilation.
       Use MSBuild input/output tracking to retain unchanged shader resources. -->
  <Target Name="PrepareRendererShaders">
    <MakeDir Directories="$(IntDir)Shaders" />
    <ItemGroup>
      <_RendererSdkDirectory Include="$(WindowsSDK_IncludePath)" />
      <_RendererSdkHeader Include="%(_RendererSdkDirectory.Identity)\d2d1effecthelpers.hlsli"
                          Condition="Exists('%(_RendererSdkDirectory.Identity)\d2d1effecthelpers.hlsli')" />
      <_RendererCompilerDirectory Include="$(FXCToolPath);$(WindowsSDK_ExecutablePath);$(WindowsSDK_ExecutablePath_x64)" />
      <_RendererCompiler Include="%(_RendererCompilerDirectory.Identity)\fxc.exe"
                         Condition="Exists('%(_RendererCompilerDirectory.Identity)\fxc.exe')" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntDir)Shaders\Settings.txt"
                      Lines="$(Configuration)|$(WindowsSDK_IncludePath)|$(PlatformToolset)|$(WindowsSDKToolArchitecture)|$(FXCToolPath)|$(UseDebugLibraries)"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="@(_RendererShader -> '$(IntDir)Shaders\%(Filename).cso');$(IntDir)Shaders\AeroColorizationEffect.fxlib;$(IntDir)Shaders\Settings.txt" />
    </ItemGroup>
  </Target>
  <Target Name="CompileRendererShaders" BeforeTargets="ResourceCompile"
          DependsOnTargets="PrepareForBuild;PrepareRendererShaders"
          Inputs="@(_RendererShader);$(MSBuildProjectFullPath);$(MSBuildThisFileDirectory)..\OpenGlass\Common.hlsli;$(MSBuildThisFileDirectory)..\OpenGlass\Blur.Common.hlsli;$(MSBuildThisFileDirectory)..\Common\CppProject.props;@(_RendererSdkHeader);@(_RendererCompiler);$(IntDir)Shaders\Settings.txt"
          Outputs="@(_RendererShader -> '$(IntDir)Shaders\%(Filename).cso');$(IntDir)Shaders\AeroColorizationEffect.fxlib">
    <FXC Source="$(MSBuildThisFileDirectory)..\OpenGlass\AeroColorizationEffect.hlsl"
         GenerateExportFile="$(IntDir)Shaders\AeroColorizationEffect.fxlib"
         GenerateExportShaderProfile="Pixel;4.0_level_9_3"
         PreprocessorDefinitions="D2D_FUNCTION;D2D_ENTRY=AeroColorizationEffect"
         AdditionalIncludeDirectories="$(WindowsSDK_IncludePath)"
         DisableOptimizations="$(UseDebugLibraries)" EnableDebuggingInformation="$(UseDebugLibraries)"
         ToolPath="$(FXCToolPath)" ToolArchitecture="$(WindowsSDKToolArchitecture)"
         SuppressStartupBanner="true" TrackFileAccess="false" />
    <FXC Source="%(_RendererShader.Identity)"
         ShaderType="%(_RendererShader.Stage)" ShaderModel="4.0_level_9_3"
         EntryPointName="%(_RendererShader.Entry)" PreprocessorDefinitions="%(_RendererShader.Defines)"
         ObjectFileOutput="$(IntDir)Shaders\%(_RendererShader.Filename).cso"
         ConsumeExportFile="$(IntDir)Shaders\AeroColorizationEffect.fxlib"
         AdditionalIncludeDirectories="$(WindowsSDK_IncludePath)"
         DisableOptimizations="$(UseDebugLibraries)" EnableDebuggingInformation="$(UseDebugLibraries)"
         ToolPath="$(FXCToolPath)" ToolArchitecture="$(WindowsSDKToolArchitecture)"
         SuppressStartupBanner="true" TrackFileAccess="false" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
    <Import Project="..\Common\NuGet.targets" Condition="Exists('..\Common\NuGet.targets')" />
  </ImportGroup>
</Project>
