<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OpenGlassInstallerEnabled Condition="'$(OpenGlassInstallerEnabled)'==''">true</OpenGlassInstallerEnabled>
    <OpenGlassIsccTool Condition="'$(OpenGlassIsccTool)'==''">ISCC.exe</OpenGlassIsccTool>
    <OpenGlassPython Condition="'$(OpenGlassPython)'==''">python</OpenGlassPython>
    <OpenGlassWindowsSdkVersion Condition="'$(OpenGlassWindowsSdkVersion)'==''">$([Microsoft.Build.Utilities.ToolLocationHelper]::GetLatestSDKTargetPlatformVersion('Windows', '10.0'))</OpenGlassWindowsSdkVersion>
    <OpenGlassSignTool Condition="'$(OpenGlassSignTool)'=='' and '$(WindowsSdkDir)'!='' and '$(OpenGlassWindowsSdkVersion)'!='' and Exists('$(WindowsSdkDir)bin\$(OpenGlassWindowsSdkVersion)\x64\signtool.exe')">$(WindowsSdkDir)bin\$(OpenGlassWindowsSdkVersion)\x64\signtool.exe</OpenGlassSignTool>
    <OpenGlassSignTool Condition="'$(OpenGlassSignTool)'==''">signtool.exe</OpenGlassSignTool>
  </PropertyGroup>

  <Target Name="OpenGlassPackageInstaller"
          AfterTargets="Build"
          Condition="'$(OpenGlassInstallerEnabled)'=='true' and ('$(Configuration)'=='Release' or '$(Configuration)'=='ReleaseSigned')">
    <Exec Condition="!Exists('$(OpenGlassIsccTool)')"
          Command="where &quot;$(OpenGlassIsccTool)&quot;"
          IgnoreExitCode="true"
          ConsoleToMSBuild="true">
      <Output TaskParameter="ExitCode" PropertyName="OpenGlassIsccExitCode" />
    </Exec>
    <Message Condition="!Exists('$(OpenGlassIsccTool)') and '$(OpenGlassIsccExitCode)'!='0'"
             Text="ISCC not found in PATH; installer packaging skipped."
             Importance="High" />
    <MSBuild Condition="Exists('$(OpenGlassIsccTool)') or '$(OpenGlassIsccExitCode)'=='0'"
             Projects="$(MSBuildThisFileDirectory)OpenGlass.Packaging.proj"
             Targets="Package"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);Platform=x64;BuildDependencies=false;OpenGlassIsccTool=$(OpenGlassIsccTool);OpenGlassPython=$(OpenGlassPython);OpenGlassSignTool=$(OpenGlassSignTool)" />
  </Target>
</Project>
