<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Package" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="..\Common\Version.props" />
  <Import Project="..\Common\CppProject.Signing.props" />
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)'==''">Release</Configuration>
    <Platform>x64</Platform>
    <BuildDependencies Condition="'$(BuildDependencies)'==''">true</BuildDependencies>
    <OpenGlassIsccTool Condition="'$(OpenGlassIsccTool)'==''">ISCC.exe</OpenGlassIsccTool>
    <OpenGlassPython Condition="'$(OpenGlassPython)'==''">python</OpenGlassPython>
    <OpenGlassSignTool Condition="'$(OpenGlassSignTool)'==''">signtool.exe</OpenGlassSignTool>
    <OpenGlassRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</OpenGlassRoot>
    <CommonOutput>$(OpenGlassRoot)Build\x64\$(Configuration)\common\</CommonOutput>
    <LegacyOutput>$(OpenGlassRoot)Build\x64\$(Configuration)\legacy\</LegacyOutput>
    <MILCompOutput>$(OpenGlassRoot)Build\x64\$(Configuration)\milcomp\</MILCompOutput>
    <InstallerOutput>$(OpenGlassRoot)Build\x64\$(Configuration)\</InstallerOutput>
    <PackagingRoot>$(OpenGlassRoot)Cache\Packaging\$(Configuration)\</PackagingRoot>
    <SignedStage>$(PackagingRoot)signed\</SignedStage>
    <UnsignedStage>$(PackagingRoot)unsigned\</UnsignedStage>
    <LegacySymbolArchive>$(InstallerOutput)OpenGlassSymbols.Legacy.zip</LegacySymbolArchive>
    <MILCompSymbolArchive>$(InstallerOutput)OpenGlassSymbols.MILComp.zip</MILCompSymbolArchive>
  </PropertyGroup>
  <ItemGroup>
    <OpenGlassBuildProject Include="$(OpenGlassRoot)OpenGlass\OpenGlass.Legacy.vcxproj" />
    <OpenGlassBuildProject Include="$(OpenGlassRoot)OpenGlass\OpenGlass.MILComp.vcxproj" />
    <OpenGlassBuildProject Include="$(OpenGlassRoot)OpenGlassHost\OpenGlassHost.vcxproj" />
    <OpenGlassBuildProject Include="$(OpenGlassRoot)OpenGlassGUI\OpenGlassGUI.vcxproj" />
    <SignedInput Include="$(LegacyOutput)OpenGlass.dll"><Destination>$(SignedStage)legacy\OpenGlass.dll</Destination></SignedInput>
    <SignedInput Include="$(MILCompOutput)OpenGlass.dll"><Destination>$(SignedStage)milcomp\OpenGlass.dll</Destination></SignedInput>
    <SignedInput Include="$(CommonOutput)OpenGlassHost.exe"><Destination>$(SignedStage)OpenGlassHost.exe</Destination></SignedInput>
    <SignedInput Include="$(CommonOutput)OpenGlassGUI.exe"><Destination>$(SignedStage)OpenGlassGUI.exe</Destination></SignedInput>
    <UnsignedInput Include="$(LegacyOutput)unsigned\OpenGlass.dll"><Destination>$(UnsignedStage)legacy\OpenGlass.dll</Destination></UnsignedInput>
    <UnsignedInput Include="$(MILCompOutput)unsigned\OpenGlass.dll"><Destination>$(UnsignedStage)milcomp\OpenGlass.dll</Destination></UnsignedInput>
    <UnsignedInput Include="$(CommonOutput)unsigned\OpenGlassHost.exe"><Destination>$(UnsignedStage)OpenGlassHost.exe</Destination></UnsignedInput>
    <UnsignedInput Include="$(CommonOutput)unsigned\OpenGlassGUI.exe"><Destination>$(UnsignedStage)OpenGlassGUI.exe</Destination></UnsignedInput>
  </ItemGroup>

  <Target Name="ValidatePackagingInputs">
    <Error Condition="'$(Configuration)'!='Release' and '$(Configuration)'!='ReleaseSigned'" Text="Packaging requires Configuration=Release or ReleaseSigned." />
    <Exec Condition="!Exists('$(OpenGlassIsccTool)')" Command="where &quot;$(OpenGlassIsccTool)&quot;" IgnoreExitCode="true" ConsoleToMSBuild="true">
      <Output TaskParameter="ExitCode" PropertyName="OpenGlassIsccExitCode" />
    </Exec>
    <Error Condition="!Exists('$(OpenGlassIsccTool)') and '$(OpenGlassIsccExitCode)'!='0'" Text="Inno Setup Compiler was not found. Set OpenGlassIsccTool to ISCC.exe or its full path." />
    <Exec Command="&quot;$(OpenGlassPython)&quot; --version" IgnoreExitCode="true" ConsoleToMSBuild="true">
      <Output TaskParameter="ExitCode" PropertyName="OpenGlassPythonExitCode" />
    </Exec>
    <Error Condition="'$(OpenGlassPythonExitCode)'!='0'" Text="Python was not found. Set OpenGlassPython to a Python 3 executable." />
  </Target>

  <Target Name="RestoreDependencies" DependsOnTargets="ValidatePackagingInputs" Condition="'$(BuildDependencies)'=='true'">
    <MSBuild Projects="@(OpenGlassBuildProject)" Targets="Restore" BuildInParallel="false" Properties="Configuration=$(Configuration);Platform=x64" />
  </Target>

  <Target Name="BuildDependencies" DependsOnTargets="RestoreDependencies" Condition="'$(BuildDependencies)'=='true'">
    <MSBuild Projects="@(OpenGlassBuildProject)" Targets="Build" BuildInParallel="false" Properties="Configuration=$(Configuration);Platform=x64" />
  </Target>

  <Target Name="StageSignedFiles" DependsOnTargets="ValidatePackagingInputs;BuildDependencies">
    <MakeDir Directories="$(SignedStage);$(SignedStage)legacy\;$(SignedStage)milcomp\;$(InstallerOutput)" />
    <Copy SourceFiles="@(SignedInput)" DestinationFiles="@(SignedInput->'%(Destination)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="StageUnsignedFiles" DependsOnTargets="StageSignedFiles" Condition="'$(Configuration)'=='ReleaseSigned'">
    <MakeDir Directories="$(UnsignedStage);$(UnsignedStage)legacy\;$(UnsignedStage)milcomp\" />
    <Copy SourceFiles="@(UnsignedInput)" DestinationFiles="@(UnsignedInput->'%(Destination)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="RemoveObsoleteInstallerOutputs">
    <Delete Files="$(InstallerOutput)OpenGlassSetup.Legacy.exe;$(InstallerOutput)OpenGlassSetup.MILComp.exe;$(InstallerOutput)OpenGlassSetup.Legacy.Signed.exe;$(InstallerOutput)OpenGlassSetup.MILComp.Signed.exe" />
  </Target>

  <Target Name="Package" DependsOnTargets="StageSignedFiles;StageUnsignedFiles;RemoveObsoleteInstallerOutputs">
    <Exec Condition="'$(Configuration)'=='Release'"
          Command="&quot;$(OpenGlassIsccTool)&quot; /DMyAppVersion=$(OpenGlassProductVersion) /DBuildPath=&quot;$(SignedStage)&quot; /DOutputPath=&quot;$(InstallerOutput)&quot; /DSetupName=OpenGlassSetup &quot;$(OpenGlassRoot)Scripts\OpenGlass.iss&quot;" />
    <Exec Condition="'$(Configuration)'=='ReleaseSigned'"
          Command="&quot;$(OpenGlassIsccTool)&quot; /DMyAppVersion=$(OpenGlassProductVersion) /DBuildPath=&quot;$(UnsignedStage)&quot; /DOutputPath=&quot;$(InstallerOutput)&quot; /DSetupName=OpenGlassSetup &quot;$(OpenGlassRoot)Scripts\OpenGlass.iss&quot;" />
    <Exec Condition="'$(Configuration)'=='ReleaseSigned'"
          Command="&quot;$(OpenGlassIsccTool)&quot; /DMyAppVersion=$(OpenGlassProductVersion) /DBuildPath=&quot;$(SignedStage)&quot; /DOutputPath=&quot;$(InstallerOutput)&quot; /DSetupName=OpenGlassSetup.Signed &quot;$(OpenGlassRoot)Scripts\OpenGlass.iss&quot;" />
    <Exec Condition="'$(Configuration)'=='ReleaseSigned' and '$(OpenGlassSignArgs)'!=''"
          Command="&quot;$(OpenGlassSignTool)&quot; $(OpenGlassSignArgs) &quot;$(InstallerOutput)OpenGlassSetup.Signed.exe&quot;" />
    <Exec WorkingDirectory="$(OpenGlassRoot)"
          Command="&quot;$(OpenGlassPython)&quot; &quot;$(OpenGlassRoot)Scripts\archive_pdbs.py&quot; --architecture legacy --configuration $(Configuration) --output &quot;$(LegacySymbolArchive)&quot;" />
    <Exec WorkingDirectory="$(OpenGlassRoot)"
          Command="&quot;$(OpenGlassPython)&quot; &quot;$(OpenGlassRoot)Scripts\archive_pdbs.py&quot; --architecture milcomp --configuration $(Configuration) --output &quot;$(MILCompSymbolArchive)&quot;" />
  </Target>
</Project>
