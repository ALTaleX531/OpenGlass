<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <ItemsProjectGuid>{9D3A67C5-E5CA-42AE-8B06-491C60E86EBE}</ItemsProjectGuid>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <!-- Allow #include files from all importing projects. -->
      <AdditionalIncludeDirectories>%(AdditionalIncludeDirectories);$(MSBuildThisFileDirectory)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ProjectCapability Include="SourceItemsFromImports" />
  </ItemGroup>
  <ItemGroup>
	<ClInclude Include="$(MSBuildThisFileDirectory)ApplicationPaths.hpp" />
	<ClInclude Include="$(MSBuildThisFileDirectory)SystemSettings.hpp" />
	<ClInclude Include="$(MSBuildThisFileDirectory)DwmSettings.hpp"><Link>Header Files\Common\DwmSettings.hpp</Link></ClInclude>
	<ClInclude Include="$(MSBuildThisFileDirectory)CustomBlurEffect.hpp"><Link>Header Files\Common\CustomBlurEffect.hpp</Link></ClInclude>
	<ClInclude Include="$(MSBuildThisFileDirectory)RenderingEffect.hpp"><Link>Header Files\Common\RenderingEffect.hpp</Link></ClInclude>
	<ClInclude Include="$(MSBuildThisFileDirectory)D2DPrivates.hpp"><Link>Header Files\Common\D2DPrivates.hpp</Link></ClInclude>
	<ClInclude Include="$(MSBuildThisFileDirectory)RectF.hpp"><Link>Header Files\Common\RectF.hpp</Link></ClInclude>
	<ClInclude Include="$(MSBuildThisFileDirectory)BlurSettings.hpp" />
	<ClInclude Include="$(MSBuildThisFileDirectory)HookHelper.hpp"><Link>Header Files\Common\HookHelper.hpp</Link></ClInclude>
	<ClInclude Include="$(MSBuildThisFileDirectory)ProjectionInvoke.hpp"><Link>Header Files\Common\ProjectionInvoke.hpp</Link></ClInclude>
	<ClInclude Include="$(MSBuildThisFileDirectory)PngAssetValidation.hpp" />
	<ClInclude Include="$(MSBuildThisFileDirectory)PeCodeViewIdentity.hpp" />
	<ClInclude Include="$(MSBuildThisFileDirectory)ThemeAtlasLayout.hpp" />
    <ClInclude Include="$(MSBuildThisFileDirectory)RegistryValueResolver.hpp" />
    <ClInclude Include="$(MSBuildThisFileDirectory)ServiceHandler.h" />
  </ItemGroup>
</Project>
